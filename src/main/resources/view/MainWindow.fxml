<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="320.0" minWidth="480.0"
            prefHeight="640.0" prefWidth="560.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tem.MainWindow">
    <children>
        <TextField fx:id="userInput"
                   onAction="#handleUserInput"
                   prefHeight="48.0"
                   promptText="Add a task or ask Tem for help..."
                   AnchorPane.bottomAnchor="12.0"
                   AnchorPane.leftAnchor="16.0"
                   AnchorPane.rightAnchor="112.0" />
        <Button fx:id="sendButton"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="48.0"
                prefWidth="84.0"
                text="Send"
                AnchorPane.bottomAnchor="12.0"
                AnchorPane.rightAnchor="16.0" />
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="ALWAYS"
                    hvalue="1.0"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="72.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer"
                      spacing="10.0" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
